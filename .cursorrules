### Phase 1 — MDX config
- [x] `next.config.mjs`:
  - [x] Enable `@next/mdx` with `remark-gfm`, `rehype-slug`, `rehype-autolink-headings`, `rehype-pretty-code`
  - [x] Set Shiki theme `{ dark: 'github-dark', light: 'github-light' }`
  - [x] Add `pageExtensions: ['ts','tsx','md','mdx']`
- [x] Global CSS: include minimal styles for `rehype-pretty-code` tokens (pre/code spacing, inline code, etc.)

---

### Phase 2 — Content structure (no parsers)
- [ ] Create `src/content/posts/` folder
- [ ] Each post is a `.mdx` file that **exports a `meta` object** (no YAML/frontmatter plugin needed):
  - [ ] Example:
    ```mdx
    export const meta = {
      title: 'Hello World',
      date: '2025-08-25',
      description: 'My first post with MDX + Shiki.',
      tags: ['intro','nextjs'],
      draft: false
    }

    # Hello World

    ```ts
    export const greet = (name: string) => `Hello, ${name}!`
    ```
    ```
- [ ] Create a tiny registry `src/content/posts/index.ts` that imports posts and exports an array:
  ```ts
  import * as HelloWorld from './hello-world.mdx';

  export type PostModule = {
    meta: {
      title: string;
      date: string; // ISO string
      description?: string;
      tags?: string[];
      draft?: boolean;
    };
    default: React.ComponentType;
    slug: string;
  };

  export const posts: PostModule[] = [
    { ...(HelloWorld as any), slug: 'hello-world' },
    // add more posts here
  ].filter(p => process.env.NODE_ENV === 'production' ? !p.meta.draft : true)
   .sort((a,b) => (a.meta.date < b.meta.date ? 1 : -1));

---

